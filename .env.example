# Copy this file to `.env` and fill in what you have.
#
# Leave GROQ_API_KEY blank to run in MOCK mode — the backend works with zero
# LLM keys, answering /v1/why over a curated seed corpus. Fill it in to go
# LIVE: real mem0 memory, real Groq answers, real GitHub PR ingestion.
#
# DATABASE_URL is ALWAYS required — the control plane (tenants, api keys,
# jobs, webhook dedup, idempotency) lives in Postgres regardless of mode.
# `docker compose up` provisions this for you automatically.

# --- Control plane (always required) ---
DATABASE_URL=postgresql://lore:lore@localhost:5432/lore

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, free, no key) ---
# Runs on your machine via fastembed. Downloads once on first live run.
# EMBEDDER_DIMS must match the model: gte-large=1024, bge-small-en-v1.5=384, bge-base=768.
EMBEDDER_MODEL=thenlper/gte-large
EMBEDDER_DIMS=1024

# --- Canon storage (vector memory) ---
# "qdrant"   = local file, zero-dependency offline dev (default)
# "pgvector" = the same Postgres as DATABASE_URL — recommended for any real
#              deployment (one connection string, one backup for everything).
VECTOR_STORE=qdrant

# --- Optional: live GitHub PR ingestion via personal token (ingest_repo) ---
GITHUB_TOKEN=

# --- GitHub App webhook (auto-capture merged PRs) ---
GITHUB_WEBHOOK_SECRET=

# --- GitHub App identity (multi-repo backfill + welcome comments) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
BACKFILL_DAYS=15

# --- Retrieval scope (single-tenant) ---
# When a query comes in with the placeholder scope ("demo"), answer against
# this GitHub account's Canon. Ignored once any API key exists (multi-tenant).
LORE_DEFAULT_ACCOUNT=

# --- Multi-tenant auth env fallback (zero-DB dev only) ---
# Comma-separated `key:login` pairs. Production should mint keys via
# POST /v1/keys instead (hashed in Postgres, revocable without a redeploy).
#   LORE_API_KEYS=lk_alice_9f3...:alice-org, lk_bob_7c2...:bob
LORE_API_KEYS=

# --- Admin secret — required to call POST/DELETE /v1/keys ---
LORE_ADMIN_SECRET=

# --- Jobs / worker ---
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=5

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
