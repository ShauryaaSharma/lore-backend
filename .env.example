# Copy this file to `.env` and fill in what you have.
#
# Leave GROQ_API_KEY blank to run in MOCK mode — the backend works with zero
# LLM keys, answering /v1/why over a curated seed corpus. Fill it in to go
# LIVE: the LangGraph agent loop, real retrieval, real GitHub PR ingestion.
#
# DATABASE_URL is ALWAYS required — the control plane (tenants, api keys,
# jobs, webhook dedup, idempotency) lives in Postgres regardless of mode.
# `docker compose up` provisions this for you automatically.

# --- Control plane (always required) ---
DATABASE_URL=postgresql://lore:lore@localhost:5432/lore

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, free, no key) ---
# Runs on your machine via fastembed. Downloads once on first live run.
# EMBEDDER_DIMS must match the model: gte-large=1024, bge-small-en-v1.5=384, bge-base=768.
EMBEDDER_MODEL=thenlper/gte-large
EMBEDDER_DIMS=1024

# --- Reranking (local, free, no key) ---
# Cross-encoder rescoring of the vector-search shortlist before it reaches
# the LLM prompt. Uses the same fastembed runtime as the embedder.
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
RERANK_TOP_K=6

# --- Semantic memory (the Canon's vector store) ---
# "qdrant"   = default. Embedded on-disk at QDRANT_PATH with no QDRANT_URL,
#              or point QDRANT_URL at a server (docker compose does this).
# "pgvector" = the same Postgres as DATABASE_URL — one connection string and
#              one backup for the whole system.
VECTOR_STORE=qdrant
QDRANT_PATH=qdrant_data
QDRANT_URL=
QDRANT_API_KEY=

# --- Agent harness (LangGraph) ---
# The loop can fetch what the Canon lacks instead of answering from a stale
# shortlist. Set false to fall back to the v1 straight-line pipeline; both
# read the same memory layer, so `python -m app.eval.harness --compare`
# scores them against each other.
AGENT_LOOP_ENABLED=true
AGENT_MAX_HOPS=4
AGENT_TEMPERATURE=0.2

# --- Procedural memory ---
# Persona, citation policy and tool policy live here as .md files so a
# behaviour change is a reviewable diff, not an untracked config edit.
PROMPTS_DIR=prompts

# --- Consolidation (episodic -> semantic) ---
# A cheap model distils raw ingested events into durable facts once a tenant
# has accumulated enough of them, so the vector store stops growing with bot
# noise. The worker sweeps for due tenants on an interval.
SUMMARIZER_MODEL=llama-3.1-8b-instant
CONSOLIDATE_AFTER_N_EVENTS=25
CONSOLIDATE_BATCH_SIZE=40
CONSOLIDATE_SWEEP_SECONDS=300

# --- Optional: live GitHub PR ingestion via personal token (ingest_repo) ---
GITHUB_TOKEN=

# --- GitHub App webhook (auto-capture merged PRs) ---
GITHUB_WEBHOOK_SECRET=

# --- GitHub App identity (multi-repo backfill + welcome comments) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
BACKFILL_DAYS=15

# --- Retrieval scope (single-tenant) ---
# When a query comes in with the placeholder scope ("demo"), answer against
# this GitHub account's Canon. Ignored once any API key exists (multi-tenant).
LORE_DEFAULT_ACCOUNT=

# --- Multi-tenant auth env fallback (zero-DB dev only) ---
# Comma-separated `key:login` pairs. Production should mint keys via
# POST /v1/keys instead (hashed in Postgres, revocable without a redeploy).
#   LORE_API_KEYS=lk_alice_9f3...:alice-org, lk_bob_7c2...:bob
LORE_API_KEYS=

# --- Admin secret — required to call POST/DELETE /v1/keys ---
LORE_ADMIN_SECRET=

# --- Jobs / worker ---
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=5

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- LLM Ops (Langfuse, self-hosted) ---
# Blank = tracing no-ops entirely; nothing in the request path depends on it.
# Start it with:
#   docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up
# then create a project at http://localhost:3000 and paste its keys here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Eval gate ---
# The LLM judge is observe-only until its scores have been checked against
# human reading — record first, gate later. The floors below are what CI
# actually enforces (tests/test_eval_harness.py).
JUDGE_ENABLED=false
JUDGE_MODEL=llama-3.3-70b-versatile
EVAL_HIT_RATE_FLOOR=0.9
EVAL_CITATION_FLOOR=0.9
